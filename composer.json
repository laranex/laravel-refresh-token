{
    "name": "laranex/laravel-refresh-token",
    "description": "A package to help you implement refresh token mechanism in your laravel application",
    "keywords": [
        "laranex",
        "laravel",
        "laravel-refresh-token",
        "laravel-refresh-token-package",
        "refresh-token"
    ],
    "homepage": "https://github.com/laranex/laravel-refresh-token",
    "license": "MIT",
    "authors": [
        {
            "name": "Nay Thu Khant",
            "email": "naythukhant644@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^7.3 || ^8.0",
        "spatie/laravel-package-tools": "^1.7.0",
        "illuminate/contracts": "^6.0|^7.0|^8.0",
        "illuminate/console": "^6.0|^7.0|^8.0",
        "illuminate/container": "^6.0|^7.0|^8.0",
        "illuminate/support": "^6.0|^7.0|^8.0",
        "lcobucci/jwt": "^3.4|^4.0",
        "lcobucci/clock": "^1.0|^2.0",
        "phpseclib/phpseclib": "^2.0|^3.0",
        "league/oauth2-server": "^7.0|^8.0",
        "nesbot/carbon": "^2.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^5.0|^6.0|^7.0",
        "nunomaduro/larastan": "^1.0|^2.0.1",
        "orchestra/testbench": "^6.0|^7.0|^8.0",
        "phpstan/extension-installer": "^1.0|^1.1",
        "phpstan/phpstan-deprecation-rules": "^0.12|^1.0",
        "phpstan/phpstan-phpunit": "^0.12|^1.0",
        "phpunit/phpunit": "^8.0|^9.0"
    },
    "autoload": {
        "psr-4": {
            "Laranex\\RefreshToken\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Laranex\\RefreshToken\\Tests\\": "tests/",
            "Laranex\\RefreshToken\\Database\\Factories\\": "database/factories/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "phpunit",
        "test-coverage": "phpunit --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "pestphp/pest-plugin": false
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Laranex\\RefreshToken\\RefreshTokenServiceProvider"
            ],
            "aliases": {
                "RefreshToken": "Laranex\\RefreshToken\\Facades\\RefreshToken"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
