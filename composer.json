{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laranex/laravel-refresh-token",
    "description": "Issue, verify, revoke and prune RS256 JWT refresh tokens for any Eloquent model in a Laravel application",
    "keywords": [
        "laravel",
        "laranex",
        "laravel-refresh-token",
        "refresh-token",
        "jwt",
        "authentication",
        "api"
    ],
    "homepage": "https://laranex.vercel.app/laravel-refresh-token",
    "license": "MIT",
    "authors": [
        {
            "name": "Nay Thu Khant",
            "email": "naythukhant644@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-openssl": "*",
        "illuminate/console": "^10.0||^11.0||^12.0||^13.0",
        "illuminate/contracts": "^10.0||^11.0||^12.0||^13.0",
        "illuminate/database": "^10.0||^11.0||^12.0||^13.0",
        "illuminate/support": "^10.0||^11.0||^12.0||^13.0",
        "lcobucci/jwt": "^5.0",
        "psr/clock": "^1.0"
    },
    "require-dev": {
        "larastan/larastan": "^2.11||^3.9",
        "laravel/pint": "^1.20||^1.29",
        "orchestra/testbench": "^8.29||^9.7||^10.0||^11.0",
        "pestphp/pest": "^2.36||^3.0||^4.6",
        "pestphp/pest-plugin-type-coverage": "^2.8.7||^3.6.1||^4.0",
        "phpstan/extension-installer": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "Laranex\\RefreshToken\\": "src/",
            "Laranex\\RefreshToken\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Laranex\\RefreshToken\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "prepare": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "build": [
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "vendor/bin/pint"
        ],
        "lint:check": [
            "vendor/bin/pint --test"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse --memory-limit=1G"
        ],
        "test:types": [
            "@php -d memory_limit=-1 vendor/bin/pest --type-coverage --min=100"
        ],
        "test:unit": [
            "vendor/bin/pest --parallel"
        ],
        "test": [
            "@analyse",
            "@lint:check",
            "@test:types",
            "@test:unit"
        ],
        "clear": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Laranex\\RefreshToken\\RefreshTokenServiceProvider"
            ],
            "aliases": {
                "RefreshToken": "Laranex\\RefreshToken\\Facades\\RefreshToken"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true,
            "php-http/discovery": true
        },
        "policy": {
            "advisories": {
                "ignore": {
                    "laravel/framework": "Dev-only: the package's test matrix installs older Laravel lines; apps resolve their own framework version"
                },
                "ignore-id": {
                    "PKSA-z3gr-8qht-p93v": "Dev-only PHPUnit advisory; needed for the PHP 8.1 test lane"
                }
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
